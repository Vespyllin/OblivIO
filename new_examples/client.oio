CLIENT

network channel SERVER/REQUEST@{} : (string@{H} * int@{H})@{H};
local channel STDOUT : string@{H};

var url : string@{H} = "/about";
var mq  : int@{H} = 1;

START@{} (ignored : int@{}) {
    send(SERVER/REQUEST, (url, mq));
}

RESPONSE@{} (page : string@{H}) {
    output(STDOUT, page);
    exit();
}
