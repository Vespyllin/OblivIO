TEST

local channel PATH: err(path((_ * int@{h})@{h})[24])@{h};
local channel STR: err(string)@{h};
local channel INT: err(int)@{h};

var c: err(path((_ * int@{h})@{h})[24])@{h} = onil(24);
var d: err(path((_ * int@{h})@{h})[24])@{h} = onil(24);

START@{} (ignored: int@{}) {
    c = oalloc(
            (oalloc(
                (onil(24), 
            6), 24), 
        5), 24);
    d = fst(*c);
    
    output(INT, snd(*c));
    output(INT, snd(*d));
    output(STR, "ok");

    exit();
}