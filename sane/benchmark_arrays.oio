TEST

local channel STR: err(string)@{};

var pub_arr: int@{}[]@{} = [1; 2; 3; 4; 5];
var priv_arr: int@{h}[]@{h} = [1; 2; 3; 4; 5];
var i: int@{} = 0;
var sink: err(int)@{h} = 0;

START@{} (ignored: int@{}) {
    output(STR, "start");

    output(STR, "pub");
    while i < 100000 do {
        sink = pub_arr[0];
        i = i + 1;
    }

    i = 0;

    output(STR, "priv");
    while i < 100000 do {
        sink = priv_arr[0];
        i = i + 1;
    }

    output(STR, "ok");
    exit();
}
