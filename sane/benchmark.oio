TEST

local channel STR: err(string)@{};

// --- selectors: edit these to pick which test to run ---
var test_struct: int@{} = 2;   // 0=array  1=path  2=map
var test_op:     int@{} = 1;   // 0=read   1=write
var test_level:  int@{} = 1;   // 0=pub    1=priv

var i: int@{} = 0;
var j: int@{} = 0;
var n: int@{} = 100000;
var n_small: int@{} = 20000;

// arrays
var pub_arr:  int@{}[]@{}   = array(4096, 100);
var priv_arr: int@{h}[]@{h} = array(100000, 100);

// paths (onil: write is a timed no-op, still measures sleep)
var pub_path:       ptr(int@{})@{}                   = alloc(32);
var priv_path8:     path(int@{h})[8]@{h}             = oalloc(8,8);
var priv_path256:   path(int@{h}[]@{h})[256]@{h}     = oalloc([256],256);
var priv_path1024:  path(int@{h}[]@{h})[1024]@{h}    = oalloc([1024],1024);
var priv_path4096:  path(int@{h}[]@{h})[4096]@{h}    = oalloc([4096],4096);

// maps
var pub_map:  map(int, int)@{}  = hmap([(0, 100);(1, 101);(2, 102);(3, 103);(4, 104)]);
var priv_map: map(int, int)@{h} = hmap([(0, 100);(1, 101);(2, 102);(3, 103);(4, 104)]);

// sinks
var sink: err(int)@{h} = 0;
var sink2: err(int@{h}[])@{h} = [0];

START@{} (ignored: int@{}) {
    if test_struct == 0 then
        if test_op == 0 then
            if test_level == 0 then {
                output(STR, "array read pub");
                while i < n_small do { 
                    while j < 5 do {
                        sink = pub_arr[j];
                        j = j + 1;
                    }
                    j = 0;
                    i = i + 1; 
                }
            } else {
                output(STR, "array read priv");
                while i < n_small do { 
                    while j < 5 do {
                        sink = priv_arr[j];
                        j = j + 1;
                    }
                    j = 0;
                    i = i + 1; 
                }
            }
        else
            if test_level == 0 then {
                output(STR, "array write pub");
                while i < n do { 
                    while j < 5 do {
                        pub_arr[j] = i;
                        j = j + 1;
                    }
                    j = 0;
                    i = i + 1; 
                }
            } else {
                 output(STR, "array write priv");
                while i < n do { 
                    while j < 5 do {
                        priv_arr[j] = i;
                        j = j + 1;
                    }
                    j = 0;
                    i = i + 1; 
                }
            }
    else if test_struct == 1 then
        if test_op == 0 then
            if test_level == 0 then {
                output(STR, "ptr read pub");
                while i < n do { sink = *pub_path; i = i + 1; }
            } else {
                output(STR, "path read priv");
                while i < n do { sink2 = *priv_path4096; i = i + 1; }
            }
        else
            if test_level == 0 then {
                output(STR, "ptr write pub");
                while i < n do { *pub_path = i; i = i + 1; }
            } else {
                output(STR, "path write priv");
                while i < n do { *priv_path4096 = array(32,i); i = i + 1; }
            }
    else
        if test_op == 0 then
            if test_level == 0 then {
                output(STR, "map read pub");
                while i < n do { sink = pub_map[[0]]; i = i + 1; }
            } else {
                output(STR, "map read priv");
                while i < n do { sink = priv_map[[0]]; i = i + 1; }
            }
        else
            if test_level == 0 then {
                output(STR, "map write pub");
                while i < n do { pub_map[[0]] = i; i = i + 1; }
            } else {
                output(STR, "map write priv");
                while i < n do { priv_map[[0]] = i; i = i + 1; }
            }

    output(STR, "ok");
    exit();
}
