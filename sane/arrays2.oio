TEST

local channel STR: err(string)@{};
local channel INT: err(int)@{h};

var arr1: int@{h}[]@{h} = [1; 2; 3];
var arr2: int@{h}[]@{h} = [4; 5];
var b: int@{h} = 0;

START@{} (ignored: int@{}) {
    output(INT, arr1[0]);

    output(INT, size(arr1));
    output(INT, size(arr2));

    oblif b
    then {
        arr2 ?= arr1;
    }
    else {
        skip;
    }

    output(INT, arr2[2]);

    output(INT, size(arr1));
    output(INT, size(arr2));

    output(STR, "ok");
    exit();
}
