TEST
local channel STR: err(string)@{h};
local channel INT: err(int)@{h};

var arr: string@{h}[]@{}[]@{} = [["A"]; ["BC"]; ["D"]];
var res: err(string)@{h} = "default";
var res: err(string@{h}[])@{} = ["default"];

START@{} (ignored: int@{}) {
    output(STR, res);
    output(INT, size(res));

    // Upperbounds size of array elements
    res = arr[0][0];
    output(STR, res);
    
    arr[0][0] = "D";
    output(STR, res);
    
    res = arr[0][0];
    output(STR, res);
    
    output(STR, "ok");
    exit();
}