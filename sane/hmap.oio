TEST

local channel INT: err(int)@{h};
local channel STR: err(string)@{};

var m: map(int, int@{h})@{h} = hmap([(0, 42); (1, 99)]);
var b: map(string, int@{h})@{h} = hmap([("A", 42); ("B", 100)]);

START@{} (ignored: int@{}) {
    // output(INT, m[[-1]]);
    output(INT, b[["D"]]);


    output(STR, "ok");
    exit();
}
