TEST

local channel STDOUT : err(int)@{H};

var p   : ptr[64](string@{H})@{H} = onil;
var q   : ptr[128](string@{H})@{H} = onil;
var s   : err(string)@{H} = "";
var t   : err(string)@{H} = "";
var len : err(int)@{H} = 0;

START@{} (ignored : int@{}) {
    q = p;
    s = *p;
    t = *q;
    
    output(STDOUT, size(s));
    output(STDOUT, size(t));
    exit();
}
