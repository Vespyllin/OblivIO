TEST

local channel STR: err(string)@{h};
local channel INT: err(int)@{h};

var m: path(int@{h}[]@{h})[64]@{h} = onil(64);
var m2: path(int@{h}[]@{h})[64]@{h} = onil(64);
var r: err(int)@{h} = 0;

START@{} (ignored: int@{}) {
  m = oram([1;2;3], 64);
  m2 = oram([1], 64);

  output(INT, size(*m));
  output(INT, size(*m2));
  
  output(STR, "ok");
  exit();
}